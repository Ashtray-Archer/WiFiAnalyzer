<resources>

    <!-- Explicit charcoal default; saved Light/System/Black choices retain their ordinals. -->
    <style name="ThemeCharcoalBase" parent="Theme.AppCompat">
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="android:windowBackground">@color/charcoal_background</item>
        <item name="android:colorBackground">@color/charcoal_background</item>
        <item name="android:colorBackgroundFloating">@color/charcoal_surface</item>
        <item name="android:textColorPrimary">@color/charcoal_text_states</item>
        <item name="android:textColorSecondary">@color/charcoal_secondary</item>
        <item name="android:textColorHint">@color/charcoal_secondary</item>
        <item name="android:textColorHighlight">@color/charcoal_selection</item>
        <item name="android:statusBarColor">@color/charcoal_background</item>
        <item name="android:navigationBarColor">@color/charcoal_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/charcoal_surface</item>
        <item name="colorPrimaryDark">@color/charcoal_background</item>
        <item name="colorAccent">@color/charcoal_focus</item>
        <item name="colorButtonNormal">@color/charcoal_interactive</item>
        <item name="colorControlNormal">@color/charcoal_secondary</item>
        <item name="colorControlActivated">@color/charcoal_text</item>
        <item name="colorControlHighlight">@color/charcoal_selection</item>
        <item name="alertDialogTheme">@style/ThemeCharcoalDialog</item>
        <item name="android:actionMenuTextColor">@color/charcoal_text</item>
    </style>
    <style name="ThemeCharcoal" parent="ThemeCharcoalBase" />
    <style name="ThemeCharcoalNoActionBar" parent="ThemeCharcoal">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="ThemeCharcoalDialog" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:colorBackground">@color/charcoal_surface</item>
        <item name="android:windowBackground">@color/charcoal_surface</item>
        <item name="android:textColorPrimary">@color/charcoal_text_states</item>
        <item name="android:textColorSecondary">@color/charcoal_secondary</item>
        <item name="colorAccent">@color/charcoal_focus</item>
        <item name="colorButtonNormal">@color/charcoal_interactive</item>
    </style>


    <!-- Black theme -->
    <style name="ThemeBlack" parent="Theme.AppCompat">
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="android:actionMenuTextColor">@color/selected</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="colorPrimary">@color/black</item>
    </style>
    <style name="ThemeBlackNoActionBar" parent="ThemeBlack">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- System (DayNight) theme -->
    <style name="ThemeSystem" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>
        <item name="android:actionMenuTextColor">@color/selected</item>
    </style>
    <style name="ThemeSystemNoActionBar" parent="ThemeSystem">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Overlay and splash styles -->
    <style name="ThemeOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="ThemeSplashBase" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/charcoal_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_inset</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
    </style>

    <style name="ThemeSplash" parent="ThemeSplashBase" />

    <!-- Window animation style -->
    <style name="WindowAnimationTransition">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
</resources>
